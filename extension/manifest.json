{
    "manifest_version":  3,
    "name":  "TaskPet for ChatGPT & Gemini",
    "version":  "1.1.0",
    "description":  "chatgpt.com·gemini.google.com에서 AI가 답을 쓰는 중인지, 끝났는지 TaskPet 로봇(Windows)에 알려 줍니다. 대화 내용은 읽지 않습니다.",
    "key":  "",
    "minimum_chrome_version":  "105",
    "permissions":  [
                        "nativeMessaging"
                    ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "run_at":  "document_idle",
                                "matches":  [
                                                "https://chatgpt.com/*",
                                                "https://chat.openai.com/*",
                                                "https://gemini.google.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ]
                            }
                        ],
    "icons":  {
                  "16":  "icons/16.png",
                  "32":  "icons/32.png",
                  "48":  "icons/48.png",
                  "128":  "icons/128.png"
              },
    "action":  {
                   "default_title":  "TaskPet for ChatGPT & Gemini",
                   "default_icon":  {
                                        "16":  "icons/16.png",
                                        "32":  "icons/32.png"
                                    }
               }
}